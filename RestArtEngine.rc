// Windows resources for RestArtEngine. The embedded icon keeps the RA
// abbreviation: assets/icons/RAEngine.ico, generated from assets/icons/RAEngine.png.

#include <windows.h>

#define IDI_RAENGINE 101

IDI_RAENGINE ICON "assets/icons/RAEngine.ico"
RAENGINE_LOGO RCDATA "assets/icons/RAEngine.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "RestArtEngine scene and material editor"
            VALUE "FileVersion", "0.2.0"
            VALUE "InternalName", "RestArtEngine"
            VALUE "OriginalFilename", "RestArtEngine.exe"
            VALUE "ProductName", "RestArtEngine"
            VALUE "ProductVersion", "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
