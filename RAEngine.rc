// Windows resources for RestArtEngine (abbreviated RAEngine in code and file names).
// The project logo lives at assets/icons/RAEngine.png; the embedded
// RAEngine.ico is generated from it (sizes 16-256) and referenced below.

#include <windows.h>

#define IDI_RAENGINE 101

IDI_RAENGINE ICON "assets/icons/RAEngine.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "RestArtEngine scene and material editor"
            VALUE "FileVersion", "0.2.0"
            VALUE "InternalName", "RAEngine"
            VALUE "OriginalFilename", "RAEngine.exe"
            VALUE "ProductName", "RestArtEngine"
            VALUE "ProductVersion", "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
