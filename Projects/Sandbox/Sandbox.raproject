{
  "format": "RAEngine.Project",
  "version": 3,
  "name": "Sandbox",
  "engineRoot": "../..",
  "engineAssociation": "0.2.0",
  "engineVersion": "0.2.0",
  "engineHash": "dev-0.2.0",
  "contentRoot": "Content",
  "shaderRoot": "Shaders",
  "defaultScene": "Content/Scenes/Default.rascene",
  "rendering": {
    "hardwareRayTracing": true,
    "globalIllumination": {
      "method": "pathTracing",
      "mode": "realtime",
      "indirectDiffuse": true,
      "indirectSpecular": true,
      "samplesPerFrame": 4,
      "targetSamples": 512,
      "maxBounces": 4
    }
  }
}
