# ---------------------------------------------------------------------------
# RestArtEngine - repository ignore rules
#
# Tracked: include/ src/ app/ tests/ Shaders/ Content/ Projects/ vendor/ scripts/
# assets/, public docs listed below, and build config (CMakeLists.txt, CMakePresets.json,
# the premake *.lua scripts) and RestArtEngine.rc. The Visual Studio solution
# and project files are GENERATED by premake (scripts/GenerateWIN.bat), so
# *.sln / *.vcxproj are ignored. Everything a build, an IDE, or a test run
# produces stays local.
#
# Note: *.obj is intentionally NOT ignored globally because Wavefront OBJ meshes
# under Projects/*/Content/Meshes/ are source content. Compiler object files
# only appear inside the ignored build directories.
# ---------------------------------------------------------------------------

# Build output
/build/
/build-*/
/out/
/install/
/install-*/
/.vs/
x64/
*.res
*.tlog
*.lastbuildstate

# Compiled binaries and linker intermediates
*.exe
*.dll
*.lib
*.exp
*.pdb
*.ilk
*.idb
*.iobj
*.ipdb
*.map

# Premake generated output (solution + project files are regenerated on demand)
/settings/
/bin/
*.sln
*.vcxproj
*.vcxproj.filters
Makefile

# Premake tool binaries (kept so the solution can be regenerated offline)
!scripts/premake/
!scripts/premake/**

# IDE / editor state
*.sln.iml
*.user
*.suo
*.vcxproj.user
*.VC.db
*.VC.opendb
imgui.ini
RestArtEngine.imgui.ini
RestArtEngine.theme.ini
RestArtEngine.ui.ini
RestArtEngine.gc.json
RestArtEngine.panels.ini

# JetBrains Rider - keep only shared project settings, ignore machine-local state
.idea/*
!.idea/.idea.RestArtEngine/
.idea/.idea.RestArtEngine/*
!.idea/.idea.RestArtEngine/.idea/
.idea/.idea.RestArtEngine/.idea/*
!.idea/.idea.RestArtEngine/.idea/.gitignore
!.idea/.idea.RestArtEngine/.idea/.name
!.idea/.idea.RestArtEngine/.idea/encodings.xml
!.idea/.idea.RestArtEngine/.idea/vcs.xml
!.idea/.idea.RestArtEngine/.idea/indexLayout.xml

# Premake IDE helper output
.run/
.fork/

# Test / validation output
/screenshots/
/artifacts/

# ---------------------------------------------------------------------------
# Public documentation allowlist. New public docs must be explicitly listed;
# research notes, progress ledgers and writing material stay local by default.
# ---------------------------------------------------------------------------
/docs/*
!/docs/Architecture.md
!/docs/AssetFormat.md
!/docs/EditorGuide.md
!/docs/EngineDistribution.md
!/docs/GarbageCollection.md
!/docs/GuiDevelopment.md
!/docs/ProjectManagement.md
!/docs/RenderingDevelopment.md
!/docs/HardwareRayTracing.md
!/docs/GlobalIllumination.md
!/docs/Diagnostics.md
!/docs/ShadowMethods.md
!/docs/UndoTransactions.md
!/docs/vendor/
/docs/vendor/*
!/docs/vendor/ImGuizmo.md
!/docs/vendor/imgui.md

# Local tool configuration (at any depth)
.agents/
.codex/
.claude/
.cursor/
.aider*
.mcp.json
AGENTS*.md
# Public optional-workspace entry; full instructions remain in ignored local/.
!/AGENTS.md
CLAUDE*.md
GEMINI.md
SKILL.md
/.github/agents/
/.github/skills/
/.github/prompts/
/.github/instructions/
/.github/copilot-instructions.md

# Local configuration and credentials; portable examples may be public
.env
.env.*
!.env.example
!.env.sample
*.local.*
CMakeUserPresets.json

# Local documents and generated media (all extensions and letter cases).
*[dD][eE][vV][lL][oO][gG]*
*[zZ][hH][iI][hH][uU]*
*开发日志*
*开发日记*
*知乎*
*第[0-9]*期*
/drafts/
/articles/
/notes/
/local/

# Operating system junk
Thumbs.db
Desktop.ini
.DS_Store

# Temporary files
*.tmp

# Generated built-in primitive assets (recreated when a project opens).
Projects/*/Content/Meshes/Builtin/

# Generated scene thumbnails (recreated when a scene is saved).
Projects/*/Content/Scenes/*.rthumb
